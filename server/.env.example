# SnapList Backend — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- CORS ---
# The deployed frontend origin (or localhost during development).
CORS_ORIGIN=http://localhost:5173

# --- Database (Slice 0: connection only, no models yet) ---
# MongoDB Atlas connection string.
MONGO_URI=

# --- Auth (used starting Slice 1 — not required for Slice 0 to boot) ---
JWT_SECRET=
JWT_EXPIRES_IN=2h

# --- ImageKit (used starting Slice 2) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Gemini (used starting Slice 3) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash